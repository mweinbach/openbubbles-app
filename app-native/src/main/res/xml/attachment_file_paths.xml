<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter-compatible storage is a sibling of filesDir. Keep the grant
         root restricted to payloads; the ObjectBox database is never shared. -->
    <files-path
        name="attachments"
        path="../app_flutter/attachments/" />
    <!-- Downloaded iCloud Photos originals, so sharing one does not require
         saving it to the gallery first. Previews and upload staging stay
         private. -->
    <files-path
        name="icloud_photo_originals"
        path="icloud_photos/originals/" />
    <cache-path
        name="diagnostics"
        path="diagnostics/" />
    <cache-path
        name="captures"
        path="captures/" />
</paths>
